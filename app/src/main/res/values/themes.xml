<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Salt 风格深色基底；状态栏/导航栏由 enableEdgeToEdge 接管 -->
    <style name="Theme.Muses" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/salt_window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- 与 MainActivity 里的 window.isNavigationBarContrastEnforced = false 同义（双保险）：
             禁止系统给导航栏叠「对比度 scrim」，否则浅色页面底部会出现一条白/浅色带 -->
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
